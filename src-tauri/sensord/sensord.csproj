<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shipped as src-tauri/binaries/sensord-x86_64-pc-windows-msvc.exe:
       `dotnet publish -c Release -o <dir>` (the single-file settings below),
       then copy <dir>/sensord.exe over it. Framework-dependent: needs .NET 8. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sensord</AssemblyName>
    <RootNamespace>Sensord</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre700" />
  </ItemGroup>

</Project>
