<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shipped binary is src-tauri/binaries/sensord-x86_64-pc-windows-msvc.exe:
       dotnet publish -c Release -r win-x64 --self-contained false
         -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o <dir>
       then copy <dir>/sensord.exe over it (framework-dependent: needs .NET 8). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sensord</AssemblyName>
    <RootNamespace>Sensord</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.7-pre700" />
  </ItemGroup>

</Project>
